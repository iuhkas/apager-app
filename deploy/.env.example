INGEST_TOKEN=bitte-aendern-ingest
INGEST_HEADER=x-apager-token
CLIENT_TOKEN=bitte-aendern-client
DEDUPE_WINDOW_SECONDS=90
DATA_DIR=/data
# Ablageort des Alarm-Logs auf dem Host.
DATA_HOST_DIR=/opt/apager/data
LOG_RETENTION_DAYS=0

# Einsatzband auf der Feuerwehr-Website (optional - leer lassen schaltet es aus).
# Uebertragen wird nur, DASS alarmiert wurde; kein Stichwort, keine Einheit.
WEBSITE_API_URL=https://ff-jeserig-flaeming.de/api/einsatz
WEBSITE_TOKEN=
# Laufzeit des Bandes in Sekunden. Leer oder 0: die Website entscheidet (3 Std).
WEBSITE_TICKER_SECONDS=
