# Port, auf dem der Relay lauscht (TLS macht der Caddy davor).
PORT=8080
# Wert, den aPager PRO im Auth-Header mitschickt.
INGEST_TOKEN=bitte-aendern-ingest
# Name des Auth-Headers, so wie in aPager PRO konfiguriert.
INGEST_HEADER=x-apager-token
# Token, mit dem sich die Desktop-App an /ws und /alarms anmeldet.
CLIENT_TOKEN=bitte-aendern-client
# Zeitfenster in Sekunden, in dem identische Alarme (mehrere Handys) zusammengefasst werden.
DEDUPE_WINDOW_SECONDS=90
# Ablageort des Alarm-Logs (alarms.jsonl).
DATA_DIR=/data
# Aufbewahrungsdauer des Logs in Tagen (0 = unbegrenzt).
LOG_RETENTION_DAYS=365
